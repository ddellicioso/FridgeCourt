rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /households/{code} {
      // Anyone signed in (anonymous counts) can read a household if they
      // know its code, and can create one. Only existing members can
      // update it (e.g. to add a new member when someone joins).
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members.keys();

      // Anyone who is already a member of the household can read/write
      // its cases. Voting is additionally restricted below.
      match /cases/{caseId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members.keys();

        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members.keys();

        // Updates are allowed for members, but a member may only ever
        // write their OWN entry into votesByUid — this is the
        // server-side half of "one vote per person" (the app also
        // checks client-side, but rules are what actually enforce it).
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members.keys()
                      && (
                        // Either votesByUid isn't changing at all...
                        request.resource.data.votesByUid == resource.data.votesByUid
                        ||
                        // ...or only this uid's own vote key changed, and
                        // it went from unset to set (can't change a vote
                        // once cast).
                        (
                          !(request.auth.uid in resource.data.votesByUid) &&
                          request.auth.uid in request.resource.data.votesByUid &&
                          request.resource.data.votesByUid
                            .diff(resource.data.votesByUid)
                            .affectedKeys()
                            .hasOnly([request.auth.uid])
                        )
                      );
      }
    }
  }
}
